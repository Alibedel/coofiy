# Copy to .env and fill in. NEVER commit the real .env.
# MongoDB Atlas connection string (mongodb+srv://user:pass@cluster/db)
DATABASE_URL=
# Long random string used to sign JWTs (e.g. `openssl rand -hex 32`)
SECRET=
# Comma-separated allowed client origins for CORS (optional in production single-origin)
CLIENT_URL=http://localhost:3000
